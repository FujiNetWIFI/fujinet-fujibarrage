; names.inc -- the items' short names (glyph strings, padded; fixed B: the
; HUD, the items line and the shop read them through pointer words, so no
; page has to call the CATALOG's page for one). The server's names are up
; to 18 letters; the Arcadia's rows are 15-16 cells. By item id (proto.h
; I_*; the catalog's order).
;   SN9  every item, 9 cells (the shop's list, the items line): items 0-27
;        at SN9 (252 bytes), 28-47 at SN9B (one 256 each: an index register)
;   SN7  the weapons (0-32), 7 cells (the HUD's row 25)
SN9:
        DB      "MINI MSL "
        DB      "MISSILE  "
        DB      "MINI NUKE"
        DB      "NUKE     "
        DB      "HOPPER   "
        DB      "CLUSTER  "
        DB      "MIRV     "
        DB      "MEGA MIRV"
        DB      "NAPALM   "
        DB      "INFERNO  "
        DB      "TRACER   "
        DB      "SMOKE TRC"
        DB      "LT ROLLER"
        DB      "ROLLER   "
        DB      "HV ROLLER"
        DB      "SHOVEL CH"
        DB      "SHOVEL BL"
        DB      "DIRT BUST"
        DB      "HV BUSTER"
        DB      "LT DRILL "
        DB      "DRILL    "
        DB      "HV DRILL "
        DB      "LT MOLE  "
        DB      "MOLE     "
        DB      "HV MOLE  "
        DB      "DIRT CLMP"
        DB      "DIRT HEAP"
        DB      "LANDSLIDE"
SN9B:
        DB      "MUDSLIDE "
        DB      "GEYSER   "
        DB      "QUAKE    "
        DB      "PLASMA   "
        DB      "LASER    "
        DB      "HT SEEKER"
        DB      "BALLISTIC"
        DB      "LV SEEKER"
        DB      "DR SEEKER"
        DB      "AUTOPILOT"
        DB      "FUEL     "
        DB      "PARACHUTE"
        DB      "BATTERY  "
        DB      "DEFLECTOR"
        DB      "SHIELD   "
        DB      "BOUNCE SH"
        DB      "HV SHIELD"
        DB      "SUPER DEF"
        DB      "DEF COMP "
        DB      "IMPACT FS"
SN7:
        DB      "MINIMSL"
        DB      "MISSILE"
        DB      "MININUK"
        DB      "NUKE   "
        DB      "HOPPER "
        DB      "CLUSTER"
        DB      "MIRV   "
        DB      "MEGMIRV"
        DB      "NAPALM "
        DB      "INFERNO"
        DB      "TRACER "
        DB      "SMKTRCR"
        DB      "LTROLLR"
        DB      "ROLLER "
        DB      "HVROLLR"
        DB      "SHVCHRG"
        DB      "SHVBLST"
        DB      "DRTBUST"
        DB      "HVBUSTR"
        DB      "LTDRILL"
        DB      "DRILL  "
        DB      "HVDRILL"
        DB      "LT MOLE"
        DB      "MOLE   "
        DB      "HV MOLE"
        DB      "DRTCLMP"
        DB      "DRTHEAP"
        DB      "LNDSLID"
        DB      "MUDSLID"
        DB      "GEYSER "
        DB      "QUAKE  "
        DB      "PLASMA "
        DB      "LASER  "
        IF      (SN9B-SN9 <> 28*9) || (SN7-SN9B <> 20*9) || ($-SN7 <> N_WEAPONS*7)
        ERROR   "names.inc: a name's width is off"
        ENDIF
