# tools/sms/build.mk -- FujiBarrage for the Sega Master System (z88dk: zcc
# +sms with zsdcc, z80asm). From the top: make sms, which runs this in the
# defoogi container unless z88dk is installed (tools/z80/z88dk).
#
#   make -f tools/sms/build.mk              r2r/sms/barrage.sms
#   ... TEST=1                              with the offline test scenes
#   ... TEST_SCENE=n TEST_ARG=a             a scene built in
#   ... VIDEO_CARD=1                        M0's test card on the screen
#   ... XFLAGS=-D...                        more flags
#
# One program (ONE_PROGRAM: the menu and the game, as the H89's) in a
# Sega-mapper image (src/sms/map.asm, tools/sms/mkrom.py). fujinet-lib is
# fujinet-lib-experimental's add-sms branch built with zsdcc
# (tools/z80/mkfnlib.sh), made by the top Makefile first. -SO2, not -SO3:
# zsdcc's -SO3 peephole has miscompiled code here (the Adam's, FujiBlast's).

ZCC := zcc
B := build/sms
R := r2r/sms
FNLIB := build/fnlib-sms

TARGET := +sms
CFLAGS := $(TARGET) -compiler=sdcc -SO2 -DUSING_FUJINET_LIB=1 -DONE_PROGRAM -DSCRIPT_AT \
	-Isrc -Isrc/platform-specific -Isrc/test -Igen -Igen/sms -Isrc/sms -Isrc/z80 \
	-I$(FNLIB)/include
ASFLAGS := -Ca-Isrc/z80 -Ca-Isrc -Ca-DFLD_SH_HI=0x80 -Ca-DSN_SEGA -Ca-DPT_SPRITES -Ca-DSMS_MUSIC
ifeq ($(TEST),1)
  CFLAGS += -DTEST_SCENES -DNO_APPKEYS $(TESTX)
endif
ifneq ($(TEST_SCENE),)
  CFLAGS += -DTEST_SCENE=$(TEST_SCENE) -DTEST_ARG=$(or $(TEST_ARG),0)
endif
ifeq ($(VIDEO_CARD),1)
  CFLAGS += -DVIDEO_CARD
endif
CFLAGS += $(XFLAGS)
LDFLAGS := $(TARGET) -compiler=sdcc -m -create-app \
	-pragma-define:CRT_INITIALIZE_BSS=1 -pragma-define:CRT_ENABLE_STDIO=0 \
	-pragma-define:CLIB_FOPEN_MAX=0 -pragma-redirect:fputc_cons=l_ret
.DEFAULT_GOAL := all
GEN := gen/sms/font.asm gen/sms/sfx.asm gen/sms/tunes.asm
HDRS := $(wildcard src/*.h src/platform-specific/*.h src/sms/*.h) gen/config.h

# FAR code (src/sms/map.asm): these files run from a ROM bank in slot 2, their
# entry points (FAR_FNS) reached through stubs (tools/sms/mkfar.py)
FAR_SRC := src/menus.c src/room.c src/appkey.c src/cat.c
FAR_FNS := message name_entry pressed room_list tick title results_enter results_frame \
	shop_enter shop_frame shop_state wait_enter wait_frame wait_state \
	appkey_clear_room appkey_load appkey_save_name appkey_save_room \
	cat_check cat_item cat_setting cat_tier cat_page cat_name numstr num32 cat_count cat_value
FAR_BANK := 2
FAR_CFLAGS := --codeseg=FAR --constseg=FAR $(foreach f,$(FAR_FNS),-D$(f)=$(f)_far)
FAR_OBJ := $(patsubst %,$(B)/%.o,$(basename $(FAR_SRC)))

SRC := src/main.c src/net.c src/play.c src/test.c gen/sms/farstub.asm \
	src/sms/plat.c src/sms/input.c src/sms/nstrans.c src/sms/card.c \
	src/sms/map.asm src/sms/smsint.asm src/sms/vdp.asm src/sms/tcache.asm src/sms/scr.asm \
	src/sms/render.asm src/sms/field.asm src/sms/mus.asm \
	src/tms9918/fld.asm src/z80/ply.asm src/z80/trk.asm src/z80/ops.asm src/z80/pt.asm \
	src/sound/snd.asm src/sn76489/sn.asm $(GEN)
OBJ := $(patsubst %,$(B)/%.o,$(basename $(SRC))) $(FAR_OBJ)

# the flags in build/sms/barrage.flags, rewritten when they change (TEST=1
# and back), so the objects build again
$(B)/barrage.flags: FORCE
	@mkdir -p $(B)
	@echo '$(CFLAGS) $(ASFLAGS)' | cmp -s - $@ || echo '$(CFLAGS) $(ASFLAGS)' > $@
$(FAR_OBJ): $(B)/%.o: %.c $(HDRS) $(B)/barrage.flags tools/sms/build.mk
	@mkdir -p $(dir $@)
	$(ZCC) $(CFLAGS) $(FAR_CFLAGS) -c -o $@ $<
$(B)/%.o: %.c $(HDRS) $(B)/barrage.flags
	@mkdir -p $(dir $@)
	$(ZCC) $(CFLAGS) -c -o $@ $<
$(B)/%.o: %.asm $(B)/barrage.flags $(wildcard src/z80/*.inc src/sms/*.inc)
	@mkdir -p $(dir $@)
	$(ZCC) $(CFLAGS) $(ASFLAGS) -c -o $@ $<

$(B)/barrage.sms: $(OBJ) $(FNLIB)/fujinet-sms.lib
	$(ZCC) $(LDFLAGS) -o $(B)/barrage $(OBJ) -L$(FNLIB) -lfujinet-sms

all: $(R)/barrage.sms

gen/sms/farstub.asm: tools/sms/mkfar.py tools/sms/build.mk
	@mkdir -p gen/sms
	python3 tools/sms/mkfar.py $@ $(FAR_BANK) $(FAR_FNS)

# the art
gen/sms/font.asm: tools/mkgfx_tms.py
	@mkdir -p gen/sms
	python3 tools/mkgfx_tms.py font $@

# the sound (tools/mksfx_z80.py): the effects; the tunes
SNDDEP := tools/mksfx_z80.py tools/mksfx_coco.py tools/mus.py tools/mkmus_intv.py src/intv/sfx.asm $(wildcard music/*.txt)
gen/sms/sfx.asm: $(SNDDEP)
	@mkdir -p gen/sms
	python3 tools/mksfx_z80.py sfx $@
# (the tunes' labels only: their notes are tools/sms/mkmus_sms.py's, in banks)
gen/sms/tunes.asm: tools/sms/build.mk
	@mkdir -p gen/sms
	printf '; GENERATED by tools/sms/build.mk: the tunes are known by these (src/sms/mus.asm)\n        SECTION rodata_user\n        PUBLIC  _t_title1, _t_title2, _t_win1, _t_win2, _t_over1, _t_over2, _t_shop1, _t_shop2, _mus_per, _mus_nz\n_t_title1: defb 1\n_t_title2: defb 2\n_t_win1: defb 3\n_t_win2: defb 4\n_t_over1: defb 5\n_t_over2: defb 6\n_t_shop1: defb 7\n_t_shop2: defb 8\n_mus_per: defw 0\n_mus_nz: defb 0\n' > $@

gen/sms/mus_psg.bin gen/sms/mus_fm.bin &: tools/sms/mkmus_sms.py tools/mus.py tools/mkmus_intv.py $(wildcard music/*.txt)
	@mkdir -p gen/sms
	python3 tools/sms/mkmus_sms.py gen/sms/mus_psg.bin gen/sms/mus_fm.bin

gen/sms/title.bin: tools/sms/mktitle_sms.py tools/mktitle_coco.py gfx/coco/namco.bin
	@mkdir -p gen/sms
	python3 tools/sms/mktitle_sms.py $@

$(R)/barrage.sms: $(B)/barrage.sms tools/sms/mkrom.py gen/sms/title.bin gen/sms/mus_psg.bin gen/sms/mus_fm.bin
	@mkdir -p $(R)
	python3 tools/sms/mkrom.py $(B) $(R) $(if $(filter 1,$(TEST)),--test)

.PHONY: all FORCE
FORCE:
