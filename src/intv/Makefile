# FujiBarrage for the Intellivision and the FujiNet cartridge (its mailbox at
# $9C00, its RAM at $8000-$9BFF, asked for 16 bits wide). There is no C
# compiler for the CP1610: these .bas files are the client again in
# IntyBASIC 1.5, the hot paths in CP1610 assembly (.asm). IntyBASIC is
# built here from its source (IB_SRC: the intybasic on PATH may be 1.4,
# which has no OPTION MAP). as1600 (on PATH) assembles; tools/intv/checkcfg.py
# fails a ROM that lands on the ECS's ROM, the cartridge's RAM or a GRAM
# mirror. (After FujiBlast's src/intv/Makefile.)
#
#   make -C src/intv              ../../r2r/intv/barrage.rom
#   make -C src/intv SERVER=h:p   the server used when the lobby gave none
#                                 (remembered in gen/server, as the Atari's)
#   make -C src/intv TEST=1       with the offline test scenes (tools/intvsim)
#   make -C src/intv rig          build/intv-rig/barrage.rom: for the rigs,
#                                 its default server 127.0.0.1:9913

.DELETE_ON_ERROR:

ROOT   := $(abspath ../..)
B      ?= $(ROOT)/build/intv
GEN    ?= $(ROOT)/gen/intv
R2R    ?= $(ROOT)/r2r/intv
DEFSRV ?=
IB_SRC ?= $(HOME)/Workspace/IntyBASIC
IB     := $(ROOT)/build/intybasic
AS1600 ?= as1600
PYTHON ?= python3
TEST   ?= 0

BAS  := $(wildcard *.bas)
ASMS := $(wildcard *.asm)
GENS := $(GEN)/proto.bas $(GEN)/config.bas $(GEN)/opts.bas $(GEN)/gfx.bas $(GEN)/music.bas $(GEN)/fixture.bas \
        $(GEN)/fldtab.asm
ROM  := $(R2R)/barrage.rom

all: $(ROM)

$(IB)/intybasic: $(wildcard $(IB_SRC)/*.cpp $(IB_SRC)/*.h)
	@mkdir -p $(IB)
	$(CXX) -O2 -o $@ $(IB_SRC)/node.cpp $(IB_SRC)/microcode.cpp $(IB_SRC)/code.cpp $(IB_SRC)/IntyBASIC.cpp
# 1.5.2's prologue has a comment written with ' (line 251), which as1600
# rejects; and MAP 2's segments are cut to the windows checkcfg.py allows, so
# IntyBASIC's own overflow check stops a build that would spill: 1 ends at
# $B7FF and 2 at $DFFF (GRAM shows through above), 3 is $F000-$F7FF (not the
# ECS's $2100)
$(IB)/intybasic_prologue.asm: $(IB_SRC)/intybasic_prologue.asm
	@mkdir -p $(IB)
	sed -e "s/  ' Max internal index/  ; Max internal index/" \
	    -e '/; MAP #2:/,/; MAP #3:/{s/\$$A000, \$$BFFF/$$A000, $$B7FF/;s/\$$C040, \$$FFFF/$$C040, $$DFFF/;s/(3, \$$2100, \$$2FFF/(3, $$F000, $$F7FF/}' $< > $@
	grep -q 'segmem(3, $$F000, $$F7FF' $@
# cell.asm's GRAM_FLUSH runs in the frame handler right after IntyBASIC's
# own DEFINE uploads (@@vii1), still inside the window GRAM is open (from
# ON FRAME it is too late: the window has closed by then); and the epilogue
# goes in segment 3 ($F000), not 0
$(IB)/intybasic_epilogue.asm: $(IB_SRC)/intybasic_epilogue.asm
	@mkdir -p $(IB)
	sed -e 's/^@@vii1:\(\r\?\)$$/@@vii1:\1\n\tCALL GRAM_FLUSH\1/' \
	    -e 's/^\tROM.SelectDefaultSegment/\tROM.SelectSegment 3/' $< > $@
	grep -q 'CALL GRAM_FLUSH' $@
	grep -q 'ROM.SelectSegment 3' $@

# the server's constants (src/proto.h, from `barraged -cheader`)
$(GEN)/proto.bas: $(ROOT)/src/proto.h
	@mkdir -p $(GEN)
	{ echo "' GENERATED from src/proto.h by src/intv/Makefile."; \
	  sed -n 's/^#define \([A-Z0-9_]*\) *\([0-9][0-9]*\)$$/    CONST \1 = \2/p' $<; } > $@

# the server used when the lobby gave none (as the Atari's: gen/server)
$(GEN)/config.bas: FORCE
	@mkdir -p $(GEN)
	@if [ -n "$(SERVER)" ]; then echo "$(SERVER)" > $(ROOT)/gen/server.new; \
	  cmp -s $(ROOT)/gen/server.new $(ROOT)/gen/server || mv $(ROOT)/gen/server.new $(ROOT)/gen/server; \
	  rm -f $(ROOT)/gen/server.new; fi
	@[ -f $(ROOT)/gen/server ] || echo "localhost:9913" > $(ROOT)/gen/server
	@{ echo "' GENERATED by src/intv/Makefile: the default server, in ASCII, 0 ended."; \
	  printf "default_srv:\n    DATA "; \
	  printf '%s' "$(if $(DEFSRV),$(DEFSRV),$$(cat $(ROOT)/gen/server))" | od -An -tu1 -v | tr -s ' \n' ',' | sed 's/^,//'; \
	  echo "0"; } > $@.new
	@cmp -s $@.new $@ || mv $@.new $@
	@rm -f $@.new

$(GEN)/opts.bas: FORCE
	@mkdir -p $(GEN)
	@echo "    CONST WITH_TEST = $(TEST)" > $@.new
	@cmp -s $@.new $@ || mv $@.new $@
	@rm -f $@.new

# the art (gfx/intv/*.txt, drawn as text)
$(GEN)/fldtab.asm: $(ROOT)/tools/mktab_intv.py
	@mkdir -p $(GEN)
	$(PYTHON) $< $@

$(GEN)/gfx.bas: $(ROOT)/tools/mkgfx_intv.py $(wildcard $(ROOT)/gfx/intv/*.txt)
	@mkdir -p $(GEN)
	$(PYTHON) $(ROOT)/tools/mkgfx_intv.py $(ROOT)/gfx/intv $(GEN)

# the tunes (music/*.txt), for the PSG
$(GEN)/music.bas: $(ROOT)/tools/mkmus_intv.py $(ROOT)/tools/mus.py $(wildcard $(ROOT)/music/*.txt)
	@mkdir -p $(GEN)
	$(PYTHON) $(ROOT)/tools/mkmus_intv.py $@ t_title=$(ROOT)/music/title.txt t_win=$(ROOT)/music/win.txt \
	    t_over=$(ROOT)/music/over.txt t_shop=$(ROOT)/music/shop.txt

# the test scenes' field and shot (refview -fixture-bas; make fixture-intv)
$(GEN)/fixture.bas: $(wildcard $(ROOT)/src/intv/test/fixture.bas) $(GEN)/opts.bas
	@mkdir -p $(GEN)
	@if [ "$(TEST)" = 1 ] && [ -f $(ROOT)/src/intv/test/fixture.bas ]; then cp $(ROOT)/src/intv/test/fixture.bas $@; \
	  else echo "' no fixture (TEST=0)" > $@; fi

# IntyBASIC looks for INCLUDEs in the folder it runs in: the sources and the
# generated files are copied there
$(B)/barrage.asm: $(BAS) $(ASMS) $(GENS) $(IB)/intybasic $(IB)/intybasic_prologue.asm $(IB)/intybasic_epilogue.asm
	@mkdir -p $(B)
	cp $(BAS) $(ASMS) $(GENS) $(B)/
	@# TEST=0: no scenes (they need the fixture)
	@if [ "$(TEST)" != 1 ]; then printf "test_check: PROCEDURE\nEND\n" > $(B)/test.bas; fi
	@# the scenes' segment: 4 (the ECS's ROM window) for jzIntv's -s0 runs only
	printf "    SEGMENT %s\n" $(if $(filter 1,$(TEST)),4,0) > $(B)/testseg.bas
	cd $(B) && $(IB)/intybasic main.bas barrage.asm $(IB)/ 2>&1 | grep -v '^Warning' | tee intybasic.log
	@! grep -q -i 'error' $(B)/intybasic.log || { rm -f $@; exit 1; }
	@# its stack 40 words, not 24: the field's asm nests deep, and the frame
	@# handler goes on top (24 overflowed into the 16-bit variables). The 16
	@# come from the unused 16-bit variables (checkvars below: they must end
	@# before IntyBASIC's own, $33F)
	sed -i 's/^STACK:\tRMB 24/STACK:\tRMB 40/' $@
	grep -q '^STACK:.RMB 40' $@

# the .bin and .cfg only for checkcfg (the .cfg is the memory map)
$(ROM): $(B)/barrage.asm $(ROOT)/tools/intv/checkcfg.py
	cd $(B) && $(AS1600) -o barrage.bin -l barrage.lst barrage.asm
	$(PYTHON) $(ROOT)/tools/intv/checkcfg.py $(if $(filter 1,$(TEST)),-test) $(B)/barrage.cfg
	@mkdir -p $(R2R)
	cd $(B) && $(AS1600) -o $(ROM) -s $(R2R)/barrage.sym barrage.asm
	@# checkvars: the 16-bit variables (after the 40-word stack) end before
	@# IntyBASIC's own, $33F (.DELETE_ON_ERROR drops the ROM if not)
	@awk '$$2 == "_SYSTEM" { if (strtonum("0x" $$1) > 0x33F) { print "16-bit variables past $$033F"; exit 1 } }' $(R2R)/barrage.sym
	@echo "$@: $$(stat -c %s $@) bytes"

rig:
	$(MAKE) B=$(ROOT)/build/intv-rig/obj GEN=$(ROOT)/build/intv-rig/gen R2R=$(ROOT)/build/intv-rig \
	    DEFSRV=127.0.0.1:9913

clean:
	rm -rf $(B) $(GEN) $(R2R) $(ROOT)/build/intv-rig

.PHONY: all clean rig FORCE
